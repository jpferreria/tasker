{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horizon Planner",
  "version": "0.1.0",
  "identifier": "com.horizon.planner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Horizon Planner",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 650,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:11434 http://127.0.0.1:11434; script-src 'self' 'wasm-unsafe-eval';"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:horizon_planner.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
